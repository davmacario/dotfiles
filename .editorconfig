root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[{*.sh,*.zsh,*.zshrc,*.szhenv,*.zprofile}]
indent_size = 2

[*.lua]
indent_style = tab
indent_size = 2
max_line_length = 88

[*.md]
trim_trailing_whitespace = false
indent_size = 2

# vim: set ft=editorconfig:
